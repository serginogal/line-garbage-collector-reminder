{
  "name": "mitaka-garbage-bot",
  "version": "1.0.0",
  "description": "LINE garbage collection reminder bot for Mitaka City",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx src/scripts/migrate.ts",
    "import": "tsx src/scripts/importCsv.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@line/bot-sdk": "^9.0.0",
    "better-sqlite3": "^11.0.0",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.4.0",
    "hono": "^4.4.0",
    "node-cron": "^3.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
